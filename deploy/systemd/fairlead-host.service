[Unit]
Description=fairlead host (one port: edge + tunnel + admin by Host)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fairlead
Group=fairlead
ExecStart=/usr/local/bin/fairlead host --config /etc/fairlead/host.toml
Restart=on-failure
RestartSec=2s
LimitNOFILE=1048576
Environment=RUST_LOG=info
# The admin password (there is no username). Keep it out of the unit file:
#   printf 'FAIRLEAD_ADMIN_PASSWORD=%s\n' 'your password' > /etc/fairlead/admin.env
#   chmod 600 /etc/fairlead/admin.env
# A value that already matches the stored hash is a no-op, so restarts do not
# sign anyone out; a new value replaces it and drops every admin session.
EnvironmentFile=-/etc/fairlead/admin.env

# Hardening: the host only needs its config, TLS material and data dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/fairlead
ReadOnlyPaths=/etc/fairlead

[Install]
WantedBy=multi-user.target
